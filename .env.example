# ============================================================
# SecureSearch Cloud — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git.
# ============================================================

# ── Flask ──────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ── Cryptographic Keys (base64-encoded 32-byte values) ─────
# Generate with:  python scripts/generate_keys.py
ENCRYPTION_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_ENCRYPTION_KEY
SEARCH_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_SEARCH_KEY
INTEGRITY_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_INTEGRITY_KEY

# Key version (increment when you rotate keys)
ENCRYPTION_VERSION=1

# ── Storage Mode ───────────────────────────────────────────
# "local"  — SQLite + local filesystem (no cloud needed)
# "cloud"  — Supabase PostgreSQL + Supabase Storage
STORAGE_MODE=local

# ── Local Storage ──────────────────────────────────────────
# Path to the folder where encrypted objects are saved locally
LOCAL_STORAGE_PATH=storage/encrypted_objects

# ── Database (local only) ──────────────────────────────────
# Leave as default for SQLite. For PostgreSQL override here.
DATABASE_URL=sqlite:///securesearch_local.db

# ── Supabase (required only when STORAGE_MODE=cloud) ───────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=secure-sensor-data

# Supabase PostgreSQL direct connection string
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── Simulator ──────────────────────────────────────────────
SIMULATOR_DEFAULT_INTERVAL=5

# ── Session Cookie Security ────────────────────────────────
# Set to "true" only when serving over HTTPS in production
SESSION_COOKIE_SECURE=false
